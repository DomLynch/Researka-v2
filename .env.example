RESEARKA_V2_POSTGRES_DSN=postgresql://researka:researka@localhost:5432/researka_v2
RESEARKA_V2_ENV=production
RESEARKA_V2_ENABLE_LEGACY_API_KEY=0
RESEARKA_V2_LEGACY_AGENT_ID=
RESEARKA_V2_POSTGRES_CONNECT_TIMEOUT_SEC=5
RESEARKA_SOURCE_CHECK_MAX=100
RESEARKA_SOURCE_CHECK_ENABLED=1
RESEARKA_DOI_CHECK_ENABLED=1
RESEARKA_DOI_CHECK_FAIL_CLOSED=1
RESEARKA_SOURCE_METADATA_CHECK_ENABLED=1
RESEARKA_SOURCE_METADATA_FAIL_CLOSED=1
RESEARKA_SOURCE_METADATA_MAX_ATTEMPTS=3
RESEARKA_CROSSREF_MAILTO=
RESEARKA_NCBI_EMAIL=
RESEARKA_V2_REVIEW_JOB_MAX_RETRIES=2
RESEARKA_V2_SKIP_SPARRING_ON_BILLING_ERROR=0
RESEARKA_V2_REVIEW_ATTESTATION_SECRET_PATH=/run/secrets/researka_review_attestation_secret
RESEARKA_INTEGRITY_ENABLED=1
RESEARKA_INTEGRITY_FAIL_CLOSED=1
RESEARKA_INTEGRITY_URL=https://integrity.researka.org
RESEARKA_INTEGRITY_TIMEOUT_S=18
RESEARKA_INTEGRITY_MAX_ATTEMPTS=2
RESEARKA_ALPHA_EXCEPTION_AGENT_IDS=
RESEARKA_DISABLED_AGENT_IDS=
RESEARKA_V2_CALIBRATION_PATH=/var/lib/researka/calibration/current.json
RESEARKA_V2_CALIBRATION_CORPUS_PATH=/var/lib/researka/calibration/frozen-corpus.json
RESEARKA_V2_ACTIVE_JUDGE_RELEASE_PATH=/var/lib/researka/calibration/active-judge-release.json
RESEARKA_V2_REVIEWER_PRIMARY_PROVIDER=minimax
RESEARKA_V2_MINIMAX_MODEL=MiniMax-M3
RESEARKA_V2_MINIMAX_BASE_URL=https://api.minimax.io/anthropic
RESEARKA_V2_REVIEWER_MODEL=google/gemma-4-31b-it
RESEARKA_V2_OPENROUTER_MODEL=google/gemma-4-31b-it
RESEARKA_V2_FALLBACK_MODEL=mistralai/mistral-small-2603
RESEARKA_V2_REVIEWER_FALLBACK_ENABLED=1
RESEARKA_V2_OPENROUTER_ALLOWED_MODELS=google/gemma-4-31b-it,mistralai/mistral-small-2603
RESEARKA_V2_OSF_OAUTH_CLIENT_ID=<osf-developer-app-client-id>
RESEARKA_V2_OSF_OAUTH_CLIENT_SECRET_PATH=/run/secrets/researka_osf_oauth_client_secret
RESEARKA_V2_OSF_OAUTH_STATE_SECRET_PATH=/run/secrets/researka_osf_oauth_state_secret
RESEARKA_V2_OSF_TOKEN_ENCRYPTION_KEY_PATH=/run/secrets/researka_osf_token_encryption_key
RESEARKA_V2_OSF_OAUTH_REDIRECT_URI=https://api.researka.org/oauth/osf/callback
RESEARKA_V2_OSF_DEFAULT_AGENT_ID=researka-platform-osf
