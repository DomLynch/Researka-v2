# Shared by API and worker. No API credentials belong in this file.
RESEARKA_V2_ENV=production
RESEARKA_V2_PROVIDER=judge_panel
RESEARKA_V2_REVIEWER_PRIMARY_PROVIDER=codex
RESEARKA_V2_CODEX_BIN=/opt/researka-codex/node_modules/.bin/codex
RESEARKA_V2_CODEX_HOME=/var/lib/researka-v2/codex
RESEARKA_V2_REVIEW_ATTESTATION_SECRET_PATH=/etc/researka/review-attestation.secret
CODEX_HOME=/var/lib/researka-v2/codex
HOME=/var/lib/researka-v2
RESEARKA_V2_OPENROUTER_ALLOWED_MODELS=z-ai/glm-5.3-flash
RESEARKA_V2_SKIP_SPARRING_ON_BILLING_ERROR=0
