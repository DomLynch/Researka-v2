[Unit]
Description=Researka v2 queue worker
After=network-online.target postgresql.service researka-v2.service
Wants=network-online.target

[Service]
Type=simple
User=researka
Group=researka
WorkingDirectory=/opt/researka-v2
EnvironmentFile=-/etc/researka/researka-v2-secrets.env
EnvironmentFile=/etc/researka/researka-v2-worker.env
EnvironmentFile=-/etc/researka/openrouter.env
EnvironmentFile=-/etc/researka/osf-oauth.env
EnvironmentFile=-/etc/researka/integrity.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=RESEARKA_V2_ENV=production
ExecStart=/opt/researka-v2/.venv/bin/python -m apps.worker.loop
Restart=always
RestartSec=5
TimeoutStopSec=1800
KillMode=mixed
UMask=0077
StateDirectory=researka-v2
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
